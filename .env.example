# Copy to .env on a private machine if desired. Do not commit secrets.

# Official Zindi file directory.
WAXAL_RAW_DIR=./google-waxal-asr-challenge20260630-10570-elxebu

# Hugging Face token is optional for public models/data, but useful for gated models.
# Never print or commit this token.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Recommended on CUDA machines when syncing with uv.
UV_TORCH_BACKEND=auto

# Optional caches. Point these at a large persistent disk on Vast.ai/Azure.
HF_HOME=/workspace/.cache/huggingface
HF_DATASETS_CACHE=/workspace/.cache/huggingface/datasets
TRANSFORMERS_CACHE=/workspace/.cache/huggingface/transformers

# Optional experiment logging.
WANDB_PROJECT=gil-waxal-asr
WANDB_MODE=offline
MLFLOW_TRACKING_URI=

